# 로컬 샘플 모드 (단일 프로세스, 실제 DB 아님)
DEMO_MODE=true
DEMO_DATA_PATH=.local/demo.json
APP_ORIGIN=http://localhost:3000
# 실제 PostgreSQL 모드: DEMO_MODE=false
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE
# DATABASE_SSL=true
# DATABASE_SSL_CA="provider root CA PEM, with literal \n between lines"
# 개발 PostgreSQL 샘플 로그인 버튼을 명시적으로 보일 때만:
# ENABLE_SAMPLE_LOGIN=true
# 샘플 seed 명령에만 ALLOW_SAMPLE_SEED=true 사용
# 초기 운영 사장님 생성 명령에만 OWNER_USERNAME / OWNER_PASSWORD 설정
