{
  "name": "onshift",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "db:up": "node scripts/migrate.mjs up",
    "db:down": "node scripts/migrate.mjs down",
    "db:seed": "tsx scripts/seed.ts",
    "verify:db": "tsx scripts/verify-db.ts",
    "db:owner": "tsx scripts/create-owner.ts",
    "verify:api": "node scripts/api-check.mjs",
    "verify:browser": "node scripts/browser-check.mjs",
    "verify:mobile": "node scripts/mobile-layout-check.mjs",
    "verify:attendance-management": "node scripts/attendance-management-check.mjs",
    "vercel-build": "npm run check:schema && npm run build",
    "check:schema": "node scripts/check-schema.mjs",
    "verify:reentry-db": "tsx scripts/reentry-db-check.ts",
    "verify:reentry-browser": "node scripts/one-button-check.mjs"
  },
  "dependencies": {
    "next": "^15.5.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "pg": "^8.16.3",
    "node-pg-migrate": "^8.0.3"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.12"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
